# Copy to .env and fill in. Keys are free and optional: without any, the app still
# works with NASA space footage, your own uploaded clips and a generated background.
#
# Pixabay (recommended): https://pixabay.com/api/docs/  (100 requests/minute)
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/  (200 requests/hour; new keys may not be available)
PEXELS_API_KEY=

# Optional
PORT=4700
HOST=0.0.0.0
# Public URL when deployed (used for share links and QR codes instead of the LAN address)
PUBLIC_BASE_URL=
# Only needed if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=
