# Copy to .env and fill in. Both keys are free.
# Pexels: https://www.pexels.com/api/  (200 requests/hour)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/  (100 requests/minute)
PIXABAY_API_KEY=

# Optional
PORT=4700
HOST=0.0.0.0
# Public URL when deployed (used for share links and QR codes instead of the LAN address)
PUBLIC_BASE_URL=
# Only needed if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=
